{
  "name": "cloudflare-video-batch-uploader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scan": "bun run src/cli.ts scan",
    "upload": "bun run src/cli.ts upload",
    "resume": "bun run src/cli.ts resume",
    "all": "bun run src/cli.ts all",
    "video-no-tags:scan": "bun run src/cli.ts scan --work-dir ./workdir/update_video_no_tags",
    "video-no-tags:duration": "bun run src/cli.ts duration --work-dir ./workdir/update_video_no_tags",
    "video-no-tags:upload": "bun run src/cli.ts upload --work-dir ./workdir/update_video_no_tags",
    "video-no-tags:all": "bun run src/cli.ts all --work-dir ./workdir/update_video_no_tags",
    "video-no-tags:export-sql": "bun run src/cli.ts export-sql --work-dir ./workdir/update_video_no_tags",
    "video-tags:scan": "bun run src/cli.ts scan --work-dir ./workdir/update_video_tags --tag-config \"./workdir/update_video_tags/本期配置清单-知识点-Drill-漏洞 - 知识点配置.csv\"",
    "video-tags:upload": "bun run src/cli.ts upload --work-dir ./workdir/update_video_tags",
    "video-tags:all": "bun run src/cli.ts all --work-dir ./workdir/update_video_tags --tag-config \"./workdir/update_video_tags/本期配置清单-知识点-Drill-漏洞 - 知识点配置.csv\"",
    "video-tags:export-sql": "bun run src/cli.ts export-sql --work-dir ./workdir/update_video_tags",
    "video:export-sql": "bun run src/cli.ts export-sql",
    "hand:generate": "bun run src/cli.ts hand generate",
    "hand:upload": "bun run src/cli.ts hand upload",
    "hand:rebuild-activities": "bun run src/cli.ts hand rebuild-activities --confirm",
    "hand:fetch-results": "bun run src/cli.ts hand fetch-results",
    "hand:all": "bun run src/cli.ts hand all",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ffmpeg-static": "^3.0.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
