# backend-framework 的服务根地址，不包含 /api，例如 http://localhost:3000
BACKEND_BASE_URL=http://localhost:3000

# 管理端登录获得的 access token；脚本会发送 x-adminimda-token: Bearer <token>
# 视频命令需要 SYS_VIDEO；复式手牌命令还需要 SYS_DUPLICATE_MATCH_HAND 和 SYS_DUPLICATE_MATCH_ACTIVITY
BACKEND_ADMIN_TOKEN=

# 可选：导出已软删除的视频时，从源 MySQL 读取完整字段；未配置时使用上面的管理端列表接口
SOURCE_DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# Web 登录获得的 access token；hand:fetch-results 通过 Authorization: Bearer <token> 查询牌谱
BACKEND_WEB_TOKEN=

# 调用 /video/add 等待 Cloudflare Stream 转码完成时的轮询参数
VIDEO_READY_POLL_INTERVAL_MS=5000
VIDEO_READY_TIMEOUT_MS=1800000
